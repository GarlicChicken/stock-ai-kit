# 외부 연동 키 자리 (예시 파일)
#
# 키는 이 파일이 아니라 같은 폴더의 '.env' 파일에 넣습니다. '.env'는 저장소에 올라가지 않습니다.
# 가장 쉬운 방법: 터미널에서 직접  uv run kit keys set <키 이름>  (값이 화면에 보이지 않음)
# 직접 만들려면: 이 파일을 '.env'로 복사한 뒤 '=' 뒤에 값을 붙여 넣기
# 확인: uv run kit keys test        자세한 설명: docs/connectors.md
#
# 키는 사람마다 따로 발급받습니다. 다른 사람과 나눠 쓰면 하루 한도가 합쳐지고, 유출되면 재발급해야 합니다.

# ---- OpenDART (공시 목록 · 기업 개황 · 재무제표) ----
# https://opendart.fss.or.kr > 인증키 신청 (무료)
DART_API_KEY=

# ---- 네이버 뉴스 검색: 새 방식 NAVER API HUB (2026-06~) ----
# 네이버 클라우드 콘솔 > NAVER API HUB > Application 등록(검색 API) > 인증 정보
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# ---- 네이버 뉴스 검색: 기존 개발자센터 키 (2027-06-30까지, 신규 발급 중단) ----
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 한국은행 ECOS (금리 · 환율 · 물가 · 통화량) ----
# https://ecos.bok.or.kr/api > 인증키 신청 (무료). 비워 두면 시험용 키로 10건까지만
ECOS_API_KEY=

# ---- 한국투자증권 Open API (조회 전용: 현재가 · 일봉 · 분봉 · 투자자별 매매동향) ----
# https://apiportal.koreainvestment.com > 계좌 개설 뒤 API 신청. 모의투자와 실전은 앱키가 따로
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=mock

# ---- 한국거래소 KRX Open API (하루치 전 종목 공식 시세) ----
# https://openapi.krx.co.kr > 인증키 신청 > 쓸 API마다 이용 신청
KRX_AUTH_KEY=

# ---- 키움증권 REST (자리만 마련, 모듈은 다음 버전) ----
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_ENV=mock
